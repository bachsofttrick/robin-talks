#!/usr/bin/env bash
#
# Generate an Android signing keystore (RSA 2048, 10000-day validity).
#
# Usage:
#   ./generate-keystore.sh
#
# Optional overrides via environment variables:
#   KEYSTORE_PATH  Output file          (default: /app/apps/mobile/credentials/android-keystore.jks)
#   KEY_ALIAS      Key entry name       (default: robintalks)
#   STORE_PASS     Keystore password    (prompted if unset)
#   KEY_PASS       Key password         (defaults to STORE_PASS)
#   DNAME          Certificate identity (default: Robin Talks)

set -euo pipefail

# Files created by keytool are readable only by the current user.
umask 077

KEYSTORE_PATH="${KEYSTORE_PATH:-$PWD/apps/mobile/credentials/android-keystore.jks}"
KEY_ALIAS="${KEY_ALIAS:-robintalks}"
DNAME="${DNAME:-CN=Robin Talks, OU=Local, O=Robin Talks, L=Unknown, ST=Unknown, C=US}"
GENPASS=robintalks

# 1. Confirm that keytool is installed.
if ! command -v keytool >/dev/null 2>&1; then
  echo "Error: keytool not found. Install a JDK (17 or newer recommended)." >&2
  exit 1
fi

# 2. Create KEYSTORE_DIR if it doesn't exist
KEYSTORE_DIR="$(dirname "$KEYSTORE_PATH")"
if [[ ! -d "$KEYSTORE_DIR" ]]; then
  mkdir -p "$KEYSTORE_DIR"
fi

# 3. Generate the key
echo "Generating keystore at: $KEYSTORE_PATH"
keytool -genkeypair -v \
  -keystore "$KEYSTORE_PATH" \
  -alias "$KEY_ALIAS" \
  -keyalg RSA -keysize 2048 -validity 10000 \
  -storepass "$GENPASS" \
  -keypass "$GENPASS" \
  -dname "$DNAME"

# 4. Print the fingerprints so you can compare them with Google Play or Firebase.
echo
echo "Keystore created. Certificate fingerprints:"
keytool -list -v \
  -keystore "$KEYSTORE_PATH" \
  -alias "$KEY_ALIAS" \
  -storepass "$GENPASS" | grep -E 'SHA1|SHA256'

echo
echo "Done. Back up $KEYSTORE_PATH and its passwords somewhere safe."
echo "Make sure the credentials folder is listed in .gitignore."
