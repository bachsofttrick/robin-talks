{
  "name": "@robin-talks/backend",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "bun run db:migrate && bun test src/db/migration.test.ts",
    "w-type": " wrangler types"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.4.18",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.3",
    "hono": "^4.13.13",
    "pg": "8.23.1",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/neon-js": "0.7.0-beta",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "bun-types": "1.4.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.12.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.149.0"
  }
}