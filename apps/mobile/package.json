{
  "name": "@robin-talks/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-entry.js",
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 expo start",
    "build": "dotenv -e .env -- eas build -p android --profile local --local --output ./robin-talks.apk",
    "build-online": "eas build -p android --profile preview",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.0",
    "@expo-google-fonts/manrope": "^0.4.0",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@supabase/supabase-js": "^2.112.4",
    "@types/jest": "30.0.0",
    "dotenv-cli": "^11.0.0",
    "expo": "^58.0.14",
    "expo-audio": "~58.0.9",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^5.5.1",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.17",
    "expo-notifications": "~58.1.5",
    "expo-print": "~58.0.6",
    "expo-sharing": "~58.0.19",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "expo-video": "~58.0.11",
    "expo-video-thumbnails": "~58.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|zod))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
