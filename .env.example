# AI
OPENROUTER_API_KEY=

# Database
PGHOST=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Backend (apps/backend)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
TRUSTED_ORIGINS=http://localhost:8081
# Set MAIL_PROVIDER=resend with MAIL_API_KEY (a Resend API key) and MAIL_FROM
# (a verified sender, for example Robin <no-reply@yourdomain.com>) to send OTP
# email through Resend. Leave MAIL_PROVIDER empty to log codes in-process.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=

# APK Build directory
EAS_LOCAL_BUILD_WORKINGDIR=/opt/android/temp